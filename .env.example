# Copy this file to .env and replace the placeholder values with your real credentials.

# JIRA Configuration
JIRA_BASE_URL=https://your-instance.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# LLM Configuration - Choose ONE option:

# Option 1: Anthropic Claude (default)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Option 2: On-Premises LLM (OpenAI-compatible)
LLM_BASE_URL=https://llm-api.amd.com/OnPrem
LLM_API_KEY=your-llm-api-key
LLM_SUBSCRIPTION_KEY=your-subscription-key-here
LLM_MODEL=gpt-4.1-mini
